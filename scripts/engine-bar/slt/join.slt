# DuckDB spelling is SEMI/ANTI JOIN; mizuchi uses LEFT SEMI/ANTI JOIN.
skipif duckdb_sql
query I rowsort
SELECT t.a FROM t LEFT SEMI JOIN u ON t.a = u.id
----
2
2

skipif duckdb_sql
query I rowsort
SELECT t.a FROM t LEFT ANTI JOIN u ON t.a = u.id
----
1
3
NULL
